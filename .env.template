# Discord Configuration (REQUIRED)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Whale Detection Threshold (default: 1000000)
USD_THRESHOLD=1000000

# CoinGecko API Configuration (optional - uses free tier if not set)
# Get your API key at: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# Monitoring interval in seconds (default: 1 = real-time, max 1 for free tier)
CHECK_INTERVAL=1

# Price Cache TTL in seconds (default: 60)
PRICE_CACHE_TTL=60
